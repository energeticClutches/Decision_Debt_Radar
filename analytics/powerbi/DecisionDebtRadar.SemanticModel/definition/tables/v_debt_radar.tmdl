	partition v_debt_radar = m
		mode: import
		source =
				let
				    Raw = Csv.Document(File.Contents(DataFolder & "\v_debt_radar.csv"), [Delimiter = ",", Columns = 21, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Raw, [PromoteAllScalars = true]),
				    Clean = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, Table.ColumnNames(Promoted)),
				    Live = PostgreSQL.Database(PgServer, PgDatabase, [Query = "SELECT decision_id, org_id, team_id, team_name, title, decision_type, risk_level::text AS risk_level, lifecycle_stage::text AS lifecycle_stage, assessment_stale, decision_due_date, assessment_id, assessment_version, assessment_state::text AS assessment_state, ddi_score, ddi_band::text AS ddi_band, band_stable, robustness_label, params_version, last_assessed_at, days_since_assessed, is_synthetic FROM v_debt_radar"]),
				    Chosen = if DataSource = "postgres" then Live else Clean,
				    Typed = Table.TransformColumnTypes(Chosen, {{"assessment_stale", type logical}, {"decision_due_date", type date}, {"assessment_version", Int64.Type}, {"ddi_score", type number}, {"band_stable", type logical}, {"days_since_assessed", Int64.Type}, {"is_synthetic", type logical}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
