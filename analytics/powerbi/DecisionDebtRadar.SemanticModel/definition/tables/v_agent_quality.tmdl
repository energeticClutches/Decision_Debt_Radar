	column is_synthetic
		dataType: boolean
		lineageTag: d0c9da53-0164-5257-b68f-7b3942eff68a
		summarizeBy: none
		sourceColumn: is_synthetic

	column provenance_label = IF(LEFT(v_agent_quality[model], 5) = "stub:", "stub, not model output", IF(ISBLANK(v_agent_quality[model]), "deterministic stage (no model)", "model output"))
		dataType: string
		lineageTag: d6c3cd1f-3531-538d-843f-152e69a4c7b0
		summarizeBy: none

	partition v_agent_quality = m
		mode: import
		source =
				let
				    Raw = Csv.Document(File.Contents(DataFolder & "\v_agent_quality.csv"), [Delimiter = ",", Columns = 14, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Raw, [PromoteAllScalars = true]),
				    Clean = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, Table.ColumnNames(Promoted)),
				    Live = PostgreSQL.Database(PgServer, PgDatabase, [Query = "SELECT agent_name, stage::text AS stage, model, prompt_version, runs, succeeded, failed, partial, runs_with_error, avg_latency_ms, tokens_in, tokens_out, claims_dropped, is_synthetic FROM v_agent_quality"]),
				    Chosen = if DataSource = "postgres" then Live else Clean,
				    Typed = Table.TransformColumnTypes(Chosen, {{"runs", Int64.Type}, {"succeeded", Int64.Type}, {"failed", Int64.Type}, {"partial", Int64.Type}, {"runs_with_error", Int64.Type}, {"avg_latency_ms", type number}, {"tokens_in", Int64.Type}, {"tokens_out", Int64.Type}, {"claims_dropped", Int64.Type}, {"is_synthetic", type logical}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
