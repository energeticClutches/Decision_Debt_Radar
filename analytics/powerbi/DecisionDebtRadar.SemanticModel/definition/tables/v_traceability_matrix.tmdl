	partition v_traceability_matrix = m
		mode: import
		source =
				let
				    Raw = Csv.Document(File.Contents(DataFolder & "\v_traceability_matrix.csv"), [Delimiter = ",", Columns = 25, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Raw, [PromoteAllScalars = true]),
				    Clean = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, Table.ColumnNames(Promoted)),
				    Live = PostgreSQL.Database(PgServer, PgDatabase, [Query = "SELECT decision_id, decision_title, assessment_id, assessment_version, claim_id, claim_text, claim_type, stance, claim_confidence, evidence_id, evidence_summary, evidence_type::text AS evidence_type, strength_grade, source_id, source_name, reliability_tier, analysis_id, analysis_type, query_ref, dq_status, conclusion_ref, array_to_string(reviewer_challenge_ids, ';') AS reviewer_challenge_ids, row_type, is_synthetic, evidence_status FROM v_traceability_matrix"]),
				    Chosen = if DataSource = "postgres" then Live else Clean,
				    Typed = Table.TransformColumnTypes(Chosen, {{"assessment_version", Int64.Type}, {"reliability_tier", Int64.Type}, {"is_synthetic", type logical}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
