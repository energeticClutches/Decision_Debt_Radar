	column reduction_label = IF(RELATED(decisions_lifecycle[latest_assessment_state]) = "scored", FORMAT(v_nbe_ranking[expected_reduction], "0.0") & " DDI points (potential, not a prediction)", "Resolves blockers (no DDI)")
		dataType: string
		lineageTag: f9e2dd6c-839a-570a-a7d6-f427152f89ce
		summarizeBy: none

	partition v_nbe_ranking = m
		mode: import
		source =
				let
				    Raw = Csv.Document(File.Contents(DataFolder & "\v_nbe_ranking.csv"), [Delimiter = ",", Columns = 17, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Raw, [PromoteAllScalars = true]),
				    Clean = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, Table.ColumnNames(Promoted)),
				    Live = PostgreSQL.Database(PgServer, PgDatabase, [Query = "SELECT recommendation_id, assessment_id, decision_id, decision_title, assessment_version, is_superseded, action_type, description, effort_days, expected_reduction, relevance, priority_score, rank_in_assessment, array_to_string(dimensions_addressed::text[], ';') AS dimensions_addressed, status::text AS status, human_note, is_synthetic FROM v_nbe_ranking"]),
				    Chosen = if DataSource = "postgres" then Live else Clean,
				    Typed = Table.TransformColumnTypes(Chosen, {{"assessment_version", Int64.Type}, {"is_superseded", type logical}, {"effort_days", type number}, {"expected_reduction", type number}, {"relevance", type number}, {"priority_score", type number}, {"rank_in_assessment", Int64.Type}, {"is_synthetic", type logical}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
