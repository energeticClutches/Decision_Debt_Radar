# Copy to .env and edit. .env is git-ignored. Never commit real secrets.
# All values below are local-development placeholders.

APP_ENV=local

# --- PostgreSQL (docker compose "db" service) ---
POSTGRES_USER=ddr
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=ddr
POSTGRES_PORT=5432

# --- Backend ---
# Used when running the backend directly on the host (outside Docker).
DATABASE_URL=postgresql+psycopg://ddr:change_me_local_only@127.0.0.1:5432/ddr
BACKEND_PORT=8000

# --- LLM mode (Day 6, D6-01): live | replay | off ---
#   replay  the local and demo default: recorded demo fixtures from backend/demo_fixtures, no key, no network. Every replayed output carries
#           provenance "stub_not_model_output" and the UI says "Replayed demo fixture, not live model output".
#   live    uses ANTHROPIC_API_KEY (Claude only)
#   off     no LLM client: the pipeline skips the LLM stages (the Day-5 behaviour without a key). The test suite forces this mode.
DDR_LLM_MODE=replay

# --- LLM (Claude only). Needed only for DDR_LLM_MODE=live. ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_PRIMARY=claude-sonnet-5-5
ANTHROPIC_MODEL_REVIEWER=claude-opus-5-5
# If the reviewer model is unavailable the Reviewer falls back to the primary model and logs it.

# --- Versioned parameter sets (see backend/config) ---
DDI_PARAMS_VERSION=ddi_params_v0.1
NBE_PARAMS_VERSION=nbe_params_v0.2
# Day 4: generic analytics parameters and the tenant (organisation) analytics configuration (backend/config/orgs/<key>/)
ANALYTICS_PARAMS_VERSION=analytics_params_v0.2
TENANT_CONFIG_VERSION=fitconnect_analytics_config_v0.2
TENANT_CONFIG_KEY=fitconnect

# --- Optional fixed as-of date (ISO) for reproducible demos. Leave empty to use today's date. The seed's as-of date is 2026-10-01: use it for the
#     replay demo (scripts/demo_prepare.py and the Playwright run set it themselves). ---
# DDR_AS_OF_DATE=2026-10-01

# --- Frontend ---
FRONTEND_PORT=3000
# The browser calls /api/... on its own origin; next.config.mjs rewrites it to API_ORIGIN (default http://127.0.0.1:8000).
# On Vercel set API_ORIGIN to the Render URL (https://<service>.onrender.com, no trailing slash). DDR_API_ORIGIN is the older name.
DDR_API_ORIGIN=http://127.0.0.1:8000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# =====================================================================================================================================
# Hosted demo (free tiers: Vercel + Render + Neon). These are set in the Render, Vercel and GitHub settings, NOT in this file. See
# docs/deployment.md. Nothing below is needed for local development; the values here are placeholders and examples, never real secrets.
# =====================================================================================================================================
# Backend (Render):
#   DDR_ENV=production            replay mode only, a fixed as-of date (2026-10-01), a JSON request log on stdout, the rate limit, forwarded
#                                 headers trusted. (APP_ENV=production is the older name.)
#   DATABASE_URL=postgres://<owner>:<password>@ep-xxxx.<region>.aws.neon.tech/neondb?sslmode=require
#                                 the DIRECT (unpooled) Neon string, a host name WITHOUT "-pooler". postgres:// is accepted and is
#                                 normalised to the postgresql+psycopg driver.
#   DDR_RATE_LIMIT=1|0            override the rate limit (default: on in production, off locally)
#   DDR_RATE_LIMIT_MUTATIONS=30   POST/PATCH requests per window per client address
#   DDR_RATE_LIMIT_PIPELINE=5     pipeline runs and re-synthesis per window per client address
#   DDR_RATE_LIMIT_WINDOW_SECONDS=600
#   DDR_LOG_REQUESTS=1|0          override the request log (default: on in production)
# Frontend (Vercel):
#   API_ORIGIN=https://<service>.onrender.com
#   NEXT_PUBLIC_DDR_PUBLIC_DEMO=1 shows "Public demo . shared data . resets nightly" in the header
# GitHub (Settings > Secrets and variables > Actions):
#   DATABASE_URL                  the same DIRECT Neon string, for the nightly demo-reset workflow
